# 由 nginx 官方 image 在啟動時以 envsubst 產生 /etc/nginx/conf.d/default.conf。
# 只會替換有定義的環境變數（BACKEND_HOST、BACKEND_PORT、DNS_RESOLVER、TILE_URL、TILE_ATTRIBUTION），
# nginx 自己的 $host、$http_upgrade 等變數不受影響。

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # proxy_pass 寫死主機名稱時，nginx 只在啟動時解析一次；backend 重建換了 IP 就會一直 502。
    # 改用變數 + resolver，每 10 秒重新解析（Docker 內建 DNS 是 127.0.0.11）
    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    set $backend_upstream http://${BACKEND_HOST}:${BACKEND_PORT};

    add_header X-Content-Type-Options nosniff always;
    # 不可用 no-referrer：OSM 圖磚使用政策要求瀏覽器送出 Referer，沒有會被回 403「Access blocked」。
    # strict-origin-when-cross-origin 跨站時只送出來源（scheme + host），不洩漏路徑
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    # img-src 放寬給圖磚伺服器（TILE_URL 可換成任何來源）；Leaflet 需要 inline style
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https: http:; style-src 'self' 'unsafe-inline'; connect-src 'self'" always;

    # 執行期設定：同一個 image 可部署到不同站點（例如隔離網路改用離線圖資）
    location = /config.json {
        default_type application/json;
        expires -1;
        return 200 '{"tileUrl":"${TILE_URL}","tileAttribution":"${TILE_ATTRIBUTION}"}';
    }

    location /api/ {
        # 這裡重新宣告 add_header，就不會繼承上面給前端用的 CSP：
        # /api/docs 的 Swagger UI 需要從 CDN 載入 JS / CSS
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy strict-origin-when-cross-origin always;
        proxy_pass $backend_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /ws/ {
        proxy_pass $backend_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # Vite 產出的檔名含雜湊，可長期快取
    location /assets/ {
        expires 1y;
        try_files $uri =404;
    }

    location / {
        expires -1;
        try_files $uri $uri/ /index.html;
    }
}
